{
  "name": "tjob",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate -w web",
    "db:migrate": "npm run db:migrate -w web",
    "ext:dev": "npm run dev -w extension",
    "ext:build": "npm run build -w extension"
  },
  "engines": {
    "node": ">=20.9"
  }
}
